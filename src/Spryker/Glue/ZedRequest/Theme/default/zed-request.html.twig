{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% set icon %}
        {{ include('@WebProfiler/Icon/http-client.svg') }}
        <span class="sf-toolbar-value">{{ collector.logs|length }}</span>
    {% endset %}

    {% set text %}
        <div class="sf-toolbar-info-piece">
            <b>Zed Requests</b>
            <span class="sf-toolbar-status">{{ collector.logs|length }}</span>
        </div>
        {% for logData in collector.logs %}
            <div class="sf-toolbar-info-piece">
                <b>#{{ loop.index }}</b>
                <span>{{ logData['destination']|split('/')|slice(-2)|join('/') }}</span>
            </div>
        {% endfor %}
    {% endset %}

    {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: profiler_url, name: 'zed_request'}) }}
{% endblock %}

{% block menu %}
    <span class="label">
        <span class="icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="#AAA" d="M20.4 12c-1 0-1.8.6-2.2 1.4l-2.6-.9c.1-.3.1-.5.1-.8 0-1.2-.6-2.2-1.5-2.9l1.5-2.6c.3.1.6.2 1 .2 1.4 0 2.5-1.1 2.5-2.5s-1.1-2.5-2.5-2.5-2.5 1.1-2.5 2.5c0 .8.4 1.5.9 1.9l-1.5 2.6c-.5-.3-1-.4-1.6-.4-.9 0-1.7.3-2.3.9L7.4 6.6c.3-.4.5-.9.5-1.5 0-1.4-1.1-2.5-2.5-2.5S2.7 3.7 2.7 5.1s1.1 2.5 2.5 2.5c.6 0 1.1-.2 1.5-.5L9 9.4c-.5.6-.8 1.4-.8 2.3 0 .7.2 1.4.6 2l-3.9 3.8c-.4-.3-.9-.5-1.5-.5C2 17 .9 18.1.9 19.5S2.2 22 3.6 22s2.5-1.1 2.5-2.5c0-.5-.2-1-.5-1.5l3.8-3.7c.7.7 1.6 1.1 2.6 1.1h.2l.4 2.4c-1 .3-1.7 1.3-1.7 2.4 0 1.4 1.1 2.5 2.5 2.5s2.5-1.1 2.5-2.5-1.1-2.5-2.5-2.5l-.4-2.5c1-.3 1.9-1 2.3-2l2.6.9v.4c0 1.4 1.1 2.5 2.5 2.5s2.5-1.1 2.5-2.5c.1-1.4-1.1-2.5-2.5-2.5z"/></svg>
        </span>
        <strong>Zed Requests</strong>
        <span class="count">
            <span>{{ collector.logs|length }}</span>
        </span>
    </span>
{% endblock %}

{% block panel %}
    <style>
        .zed-request-table {
            table-layout: auto;
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }
        .zed-request-table .col-shrink {
            white-space: nowrap;
            width: 1%;
        }
        .zed-request-table .col-fill {
            width: 99%;
        }
        .zed-request-table th {
            background: #2e3d50;
            color: #fff;
            padding: 9px 10px;
            text-align: left;
            font-weight: 600;
            font-size: 12px;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }
        .zed-request-table td {
            padding: 8px 10px;
            vertical-align: top;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            background: transparent;
        }
        .zed-request-table tbody tr.zed-request-row-even td {
            background: rgba(255, 255, 255, 0.03);
        }
        .zed-request-table code {
            background: #eef1f5;
            padding: 1px 5px;
            border-radius: 3px;
            font-size: 12px;
            color: #3c4c60;
        }

        .zed-request-module {
            display: inline-block;
            padding: 2px 7px;
            border-radius: 3px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            white-space: nowrap;
            background: #42a5f5;
            color: #fff;
        }

        .zed-request-payload-row td {
            padding-top: 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }
        .zed-request-payload-row.zed-request-row-even td {
            background: rgba(255, 255, 255, 0.03);
        }
        .zed-request-row-has-payload td {
            border-bottom: none;
        }
        .zed-request-payload-cell {
            padding: 6px 10px 10px 10px;
        }
        .zed-request-payload-content {
            border-radius: 4px;
            padding: 10px 14px;
            margin-top: 4px;
            overflow-x: auto;
            max-height: 500px;
            overflow-y: auto;
        }
        .zed-request-table details {
            display: inline-block;
            padding-top: 4px;
            margin-right: 8px;
        }
        .zed-request-table details summary {
            display: inline-block;
            cursor: pointer;
            font-size: 12px;
            color: #ccc;
            font-weight: 500;
            padding: 3px 10px;
            border-radius: 3px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(255, 255, 255, 0.06);
            user-select: none;
            transition: background 0.12s, border-color 0.12s, color 0.12s;
        }
        .zed-request-table details summary:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(255, 255, 255, 0.35);
            color: #fff;
        }
        .zed-request-table details[open] summary {
            margin-bottom: 6px;
            background: #2e3d50;
            border-color: #2e3d50;
            color: #fff;
        }

        .zed-request-empty {
            padding: 40px 20px;
            text-align: center;
            color: #999;
            font-size: 14px;
            border: 1px dashed #ddd;
            border-radius: 6px;
        }
    </style>

    <h2>Zed Requests</h2>

    {% if collector.logs is empty %}
        <div class="zed-request-empty">
            No Zed requests were captured for this request.
        </div>
    {% else %}
        <table class="zed-request-table">
            <thead>
                <tr>
                    <th class="col-shrink">#</th>
                    <th class="col-shrink">Module</th>
                    <th class="col-fill">Destination</th>
                </tr>
            </thead>
            <tbody>
                {% for i, logData in collector.logs %}
                    {% set path = logData['destination']|split('?')|first %}
                    {% set segments = path|trim('/')|split('/') %}
                    <tr class="{% if i is even %}zed-request-row-even{% endif %} zed-request-row-has-payload">
                        <td class="col-shrink">{{ i + 1 }}</td>
                        <td class="col-shrink">
                            <span class="zed-request-module">{{ segments|length > 2 ? segments[segments|length - 3] : 'zed' }}</span>
                        </td>
                        <td>
                            <code>{{ path }}</code>
                        </td>
                    </tr>
                    <tr class="zed-request-payload-row {% if i is even %}zed-request-row-even{% endif %}">
                        <td colspan="3" class="zed-request-payload-cell">
                            <details>
                                <summary>Show payload</summary>
                                <div class="zed-request-payload-content">
                                    {{ profiler_dump(logData['payload'], maxDepth=2) }}
                                </div>
                            </details>
                            <details>
                                <summary>Show result</summary>
                                <div class="zed-request-payload-content">
                                    {{ profiler_dump(logData['result'], maxDepth=2) }}
                                </div>
                            </details>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
